    "ir": "paralyn.ir v0\nkernel alias_steps(a: read_write buffer<f32>, b: read_write buffer<f32>, c: read_write buffer<f32>, n: i32, scale: f32) {\n  let i:i32 = i32(((blockIdx.x * blockDim.x) + threadIdx.x))\n  if (i < n) {\n    store a[i] = (load a[i] + load b[i])\n    store c[i] = ((load a[i] * scale) + load b[i])\n  }\n}\n\nparalyn.ir v0\nkernel const_alias(input: read buffer<f32>, output: read_write buffer<f32>, n: i32) {\n  let i:i32 = i32(((blockIdx.x * blockDim.x) + threadIdx.x))\n  if (i < n) {\n    store output[i] = (load input[i] + 1.0E+0:f32)\n    store output[i] = (load input[i] + 2.0E+0:f32)\n  }\n}\n\nparalyn.ir v0\nkernel mixed_pointees(a: read_write buffer<f32>, b: read_write buffer<i32>) {\n  store b[0:i32] = 1:i32\n}\n\nparalyn.ir v0\nkernel unsigned_values(output: read_write buffer<u32>, bias: u32) {\n  let i:i32 = i32(threadIdx.x)\n  store output[i] = (threadIdx.x + bias)\n}\n\n"
