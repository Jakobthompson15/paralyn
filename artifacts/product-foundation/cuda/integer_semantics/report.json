    "ir": "paralyn.ir v0\nkernel signed_affine(input: read buffer<i32>, output: read_write buffer<i32>, n: i32, scale: i32, bias: i32) {\n  let i:i32 = i32(threadIdx.x)\n  if (i < n) {\n    store output[i] = ((load input[i] * scale) + bias)\n  }\n}\n\nparalyn.ir v0\nkernel unsigned_to_signed(input: read buffer<u32>, output: read_write buffer<i32>, n: i32) {\n  let i:i32 = i32(threadIdx.x)\n  if (i < n) {\n    store output[i] = i32(load input[i])\n  }\n}\n\nparalyn.ir v0\nkernel signed_to_unsigned(input: read buffer<i32>, output: read_write buffer<u32>, n: i32) {\n  let i:i32 = i32(threadIdx.x)\n  if (i < n) {\n    store output[i] = u32(load input[i])\n  }\n}\n\nparalyn.ir v0\nkernel unsigned_comparison(output: read_write buffer<i32>, bound: i32) {\n  if (threadIdx.x < u32(bound)) {\n    store output[threadIdx.x] = 1:i32\n  }\n}\n\n"
