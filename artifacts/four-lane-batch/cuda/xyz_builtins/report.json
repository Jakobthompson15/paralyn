    "ir": "paralyn.ir v0\nkernel record_coordinates(output: read_write buffer<i32>, guard: i32) {\n  let x:i32 = i32(((blockIdx.x * blockDim.x) + threadIdx.x))\n  let y:i32 = i32(((blockIdx.y * blockDim.y) + threadIdx.y))\n  let z:i32 = i32(((blockIdx.z * blockDim.z) + threadIdx.z))\n  let width:i32 = i32((gridDim.x * blockDim.x))\n  let height:i32 = i32((gridDim.y * blockDim.y))\n  let base:i32 = ((((((z * height) + y) * width) + x) * 12:i32) + guard)\n  store output[(base + 0:i32)] = i32(threadIdx.x)\n  store output[(base + 1:i32)] = i32(threadIdx.y)\n  store output[(base + 2:i32)] = i32(threadIdx.z)\n  store output[(base + 3:i32)] = i32(blockIdx.x)\n  store output[(base + 4:i32)] = i32(blockIdx.y)\n  store output[(base + 5:i32)] = i32(blockIdx.z)\n  store output[(base + 6:i32)] = i32(blockDim.x)\n  store output[(base + 7:i32)] = i32(blockDim.y)\n  store output[(base + 8:i32)] = i32(blockDim.z)\n  store output[(base + 9:i32)] = i32(gridDim.x)\n  store output[(base + 10:i32)] = i32(gridDim.y)\n  store output[(base + 11:i32)] = i32(gridDim.z)\n}\n\n"
